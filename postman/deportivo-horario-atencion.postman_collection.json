					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains Horario details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.canchaId).to.eql(1);",
									"    pm.expect(jsonData.diaSemana).to.eql(2);",
									"    pm.expect(jsonData.horaApertura).to.eql(\"08:00:00\");",
									"    pm.expect(jsonData.horaCierre).to.eql(\"22:00:00\");",
									"    pm.collectionVariables.set(\"created_horario_id\", jsonData.id);",
									"});",
									"",
									"pm.test(\"Header Location is present\", function () {",
									"    pm.response.to.have.header(\"Location\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
