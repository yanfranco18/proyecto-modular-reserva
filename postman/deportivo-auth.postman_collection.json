{
	"info": {
		"_postman_id": "9f4c312b-8c5d-4f90-a2b3-deportivo-auth-01",
		"name": "Deportivo System - Auth API",
		"description": "Colección completa de pruebas de API para el módulo Auth del sistema deportivo, incluyendo login (por username o email), registro de usuarios y obtención del perfil actual con autenticación JWT Bearer.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "registered_username",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. POST - Auth Login",
			"item": [
				{
					"name": "1.1 Login Exitoso con Username (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains accessToken, tokenType, and user\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
									"    pm.expect(jsonData.expiresIn).to.be.a('number');",
									"    pm.expect(jsonData.user).to.be.an('object');",
									"    pm.expect(jsonData.user.username).to.eql(\"superadmin\");",
									"    pm.collectionVariables.set(\"auth_token\", jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Caso de prueba: Autenticación exitosa usando username."
					},
					"response": []
				},
				{
					"name": "1.2 Login Exitoso con Email (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains accessToken for email login\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.user.email).to.eql(\"admin@system.com\");",
									"    pm.collectionVariables.set(\"auth_token\", jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@system.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Caso de prueba: Autenticación exitosa usando el correo electrónico."
					},
					"response": []
				},
				{
					"name": "1.3 Login - Credenciales Inválidas (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Response contains error details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.eql(\"UNAUTHORIZED\");",
									"    pm.expect(jsonData.status).to.eql(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"wrong_password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Caso de prueba: Intento de login con contraseña incorrecta."
					},
					"response": []
				},
				{
					"name": "1.4 Login - Usuario Inexistente (401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
