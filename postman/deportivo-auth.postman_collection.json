			]
		},
		{
			"name": "2. POST - Auth Register",
			"item": [
				{
					"name": "2.1 Registro Exitoso de Cliente (201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains new user details without passwordHash\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.username).to.be.a('string');",
									"    pm.expect(jsonData.email).to.be.a('string');",
									"    pm.expect(jsonData.role).to.eql(\"ROLE_CUSTOMER\");",
									"    pm.expect(jsonData).to.not.have.property('passwordHash');",
									"    pm.collectionVariables.set(\"registered_username\", jsonData.username);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"nuevo_cliente_\" + Math.floor(Math.random() * 10000),\n  \"email\": \"cliente_\" + Math.floor(Math.random() * 10000) + \"@deportivo.com\",\n  \"password\": \"secret123\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Caso de prueba: Registrar un nuevo usuario cliente exitosamente."
					},
					"response": []
				},
				{
					"name": "2.2 Registro - Username Duplicado (409)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 409 Conflict\", function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test(\"Response code is CONFLICT\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.eql(\"CONFLICT\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"superadmin\",\n  \"email\": \"nuevo_email_unico@deportivo.com\",\n  \"password\": \"secret123\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Caso de prueba: Intentar registrar un usuario con un nombre de usuario ya existente."
					},
					"response": []
				},
				{
					"name": "2.3 Registro - Email Duplicado (409)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 409 Conflict\", function () {",
									"    pm.response.to.have.status(409);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"usuario_nuevo_unico\",\n  \"email\": \"admin@system.com\",\n  \"password\": \"secret123\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Caso de prueba: Intentar registrar un usuario con un correo ya existente."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. GET - Auth Profile (/me)",
			"item": [
				{
					"name": "3.1 Obtener Perfil Actual - Exitoso (200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response contains current user details\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.username).to.be.a('string');",
									"    pm.expect(jsonData.email).to.be.a('string');",
									"    pm.expect(jsonData).to.not.have.property('passwordHash');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Caso de prueba: Obtener el perfil del usuario autenticado usando el token JWT Bearer."
					},
					"response": []
				},
				{
					"name": "3.2 Obtener Perfil Sin Token (401)",
					"event": [
